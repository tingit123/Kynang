# ══════════════════════════════════════════════
#  .env.example – Mẫu biến môi trường
#  SAO CHÉP file này thành .env rồi điền giá trị thật
#  KHÔNG điền key thật vào file này!
# ══════════════════════════════════════════════

# ─── MySQL Database ───
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=skillgap_db
MYSQL_USER=skillgap_user
MYSQL_PASSWORD=your_password_here

# ─── Core API Backend ───
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=skillgap_db
DB_USER=skillgap_user
DB_PASS=your_password_here

# ─── AI / LLM Keys ───
# Lấy tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq High-Speed LLM Key
GROQ_API_KEY=

# CV evidence: auto = Gemini -> Groq -> keyword; keyword runs without API keys.
EVIDENCE_PROVIDER=auto
EVIDENCE_GEMINI_MODEL=gemini-2.5-flash
EVIDENCE_GROQ_MODEL=llama-3.3-70b-versatile
# Optional: supply DEMO_PASSWORD to seed_demo_evidence.py; otherwise generated.

# ─── Crawler ───
API_BASE_URL=http://core-api:8000
CRAWL_INTERVAL_HOURS=6

# ─── Dashboard & Auth Web ───
DASHBOARD_PORT=8080
AUTH_PORT=8081
DASHBOARD_URL=http://localhost:8080

# ─── Security & Authentication ───
JWT_SECRET=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

# Employer notifications: empty settings keep email disabled.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURITY=starttls
NOTIFY_SIMULATE=0
DEMO_EMPLOYER_LOGIN=0

