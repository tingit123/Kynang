# ══════════════════════════════════════════════
#  .env.example – Mẫu biến môi trường
#  SAO CHÉP file này thành .env rồi điền giá trị thật
#  KHÔNG điền key thật vào file này!
# ══════════════════════════════════════════════

# ─── MySQL Database ───
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=skillgap_db
MYSQL_USER=skillgap_user
MYSQL_PASSWORD=skillgap_pass

# ─── Core API Backend ───
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=skillgap_db
DB_USER=skillgap_user
DB_PASS=skillgap_pass

# ─── AI / LLM Keys ───
# Lấy tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Crawler ───
API_BASE_URL=http://core-api:8000
CRAWL_INTERVAL_HOURS=6

# ─── Dashboard ───
DASHBOARD_PORT=8080
