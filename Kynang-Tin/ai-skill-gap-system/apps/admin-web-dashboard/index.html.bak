<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>SkillGap AI – Hệ Thống Phân Tích Kỹ Năng Lao Động | Cần Thơ</title>
<meta name="description" content="Hệ thống AI phân tích khoảng cách kỹ năng lao động, gợi ý nghề nghiệp và khóa học phù hợp."/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f1f5f9;--bg2:#ffffff;--bg3:#f8fafc;
  --border:rgba(0,0,0,0.08);--border2:rgba(0,0,0,0.14);
  --text:#0f172a;--text2:#475569;--text3:#94a3b8;
  --primary:#4f46e5;--primary-light:#6366f1;--primary-glow:rgba(79,70,229,0.15);
  --green:#10b981;--amber:#f59e0b;--red:#ef4444;--purple:#a855f7;--cyan:#06b6d4;
  --sidebar-w:260px;--topbar-h:62px;--radius:14px;--radius-sm:8px;
  --shadow:0 2px 16px rgba(0,0,0,0.07);--shadow-lg:0 8px 40px rgba(0,0,0,0.12);
  --hover-bg:rgba(79,70,229,0.05);--transition:all 0.22s ease;
}
[data-theme="dark"]{
  --bg:#0c0e1a;--bg2:#131726;--bg3:#1a1f30;
  --border:rgba(255,255,255,0.07);--border2:rgba(255,255,255,0.13);
  --text:#e2e8f0;--text2:#8892a4;--text3:#4b5577;
  --primary:#6366f1;--primary-light:#818cf8;--primary-glow:rgba(99,102,241,0.18);
  --shadow:0 2px 16px rgba(0,0,0,0.45);--shadow-lg:0 8px 40px rgba(0,0,0,0.55);
  --hover-bg:rgba(99,102,241,0.08);
}
html{scroll-behavior:smooth}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);font-size:14px;line-height:1.6;overflow-x:hidden}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px}

/* ──────────────── LAYOUT ──────────────── */
.shell{display:flex;min-height:100vh}

/* ──────────────── SIDEBAR ──────────────── */
.sidebar{
  width:var(--sidebar-w);background:var(--bg2);
  border-right:1px solid var(--border);
  display:flex;flex-direction:column;
  position:fixed;top:0;left:0;bottom:0;z-index:200;
  transition:transform 0.28s ease;overflow:hidden;
}
.sidebar.collapsed{transform:translateX(calc(-1 * var(--sidebar-w)))}
.sidebar-logo{
  padding:20px 20px 16px;
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:12px;
}
.logo-icon{
  width:38px;height:38px;border-radius:10px;
  background:linear-gradient(135deg,var(--primary),var(--purple));
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.logo-icon svg{width:20px;height:20px;stroke:#fff}
.logo-title{font-size:15px;font-weight:800;color:var(--text);letter-spacing:-0.3px}
.logo-sub{font-size:10px;color:var(--text3);margin-top:1px}
.sidebar-nav{flex:1;overflow-y:auto;padding:12px 10px}
.nav-group-label{
  font-size:9.5px;font-weight:700;color:var(--text3);
  text-transform:uppercase;letter-spacing:1px;
  padding:10px 10px 6px;
}
.nav-item{
  display:flex;align-items:center;gap:10px;
  padding:9px 12px;border-radius:var(--radius-sm);
  cursor:pointer;color:var(--text2);font-size:13px;font-weight:500;
  transition:var(--transition);margin-bottom:2px;position:relative;user-select:none;
}
.nav-item:hover{background:var(--hover-bg);color:var(--primary)}
.nav-item.active{background:var(--primary-glow);color:var(--primary);font-weight:700}
.nav-item.active::before{
  content:'';position:absolute;left:0;top:20%;bottom:20%;
  width:3px;border-radius:2px;background:var(--primary);
}
.nav-item svg{width:17px;height:17px;flex-shrink:0;stroke:currentColor;stroke-width:2}
.nav-badge{
  margin-left:auto;font-size:10px;font-weight:700;
  padding:2px 7px;border-radius:20px;
  background:var(--primary-glow);color:var(--primary);
}
.nav-badge.green{background:rgba(16,185,129,0.12);color:var(--green)}
.nav-badge.red{background:rgba(239,68,68,0.12);color:var(--red)}
.sidebar-footer{
  padding:14px 16px;border-top:1px solid var(--border);
  display:flex;align-items:center;gap:10px;
}
.ai-dot{width:8px;height:8px;border-radius:50%;background:var(--green);flex-shrink:0;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(16,185,129,0.6)}50%{box-shadow:0 0 0 6px rgba(16,185,129,0)}}
.footer-text{font-size:11px;color:var(--text3)}

/* ──────────────── MAIN ──────────────── */
.main{margin-left:var(--sidebar-w);flex:1;display:flex;flex-direction:column;transition:margin-left 0.28s ease}
.main.expanded{margin-left:0}

/* ──────────────── TOPBAR ──────────────── */
.topbar{
  height:var(--topbar-h);background:var(--bg2);
  border-bottom:1px solid var(--border);
  display:flex;align-items:center;justify-content:space-between;
  padding:0 24px;position:sticky;top:0;z-index:100;
}
.topbar-left{display:flex;align-items:center;gap:14px}
.topbar-right{display:flex;align-items:center;gap:10px}
.menu-btn{
  background:none;border:1px solid var(--border2);border-radius:var(--radius-sm);
  padding:7px;cursor:pointer;color:var(--text2);display:flex;transition:var(--transition);
}
.menu-btn:hover{background:var(--hover-bg);color:var(--primary)}
.breadcrumb{display:flex;align-items:center;gap:6px;font-size:13px}
.bc-sep{color:var(--text3)}
.bc-cur{font-weight:700;color:var(--text)}
.topbar-filters{display:flex;align-items:center;gap:8px}
.filter-label{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.7px}
.filter-select{
  background:var(--bg3);border:1px solid var(--border2);
  color:var(--text);font-size:12px;padding:5px 10px;
  border-radius:var(--radius-sm);cursor:pointer;font-family:inherit;
  transition:var(--transition);
}
.filter-select:focus{outline:none;border-color:var(--primary)}
.icon-btn{
  background:none;border:1px solid var(--border);border-radius:var(--radius-sm);
  color:var(--text2);cursor:pointer;padding:8px;display:flex;
  align-items:center;transition:var(--transition);position:relative;
}
.icon-btn:hover{background:var(--hover-bg);color:var(--primary)}
.icon-btn svg{width:18px;height:18px}
.notif-dot{
  position:absolute;top:5px;right:5px;width:7px;height:7px;
  border-radius:50%;background:var(--red);border:2px solid var(--bg2);
}
.user-chip{
  display:flex;align-items:center;gap:8px;cursor:pointer;
  padding:4px 10px 4px 4px;border-radius:30px;
  background:var(--bg3);border:1px solid var(--border);
  transition:var(--transition);
}
.user-chip:hover{border-color:var(--primary-light)}
.user-avatar{
  width:30px;height:30px;border-radius:50%;
  background:linear-gradient(135deg,var(--primary),var(--purple));
  display:flex;align-items:center;justify-content:center;
  font-size:11px;font-weight:800;color:#fff;
}
.user-name{font-size:12px;font-weight:600;color:var(--text)}
.theme-toggle{background:none;border:1px solid var(--border);border-radius:var(--radius-sm);padding:7px;cursor:pointer;color:var(--text2);display:flex;transition:var(--transition)}
.theme-toggle:hover{background:var(--hover-bg);color:var(--primary)}
.theme-toggle svg{width:18px;height:18px}

/* ──────────────── PAGE ──────────────── */
.page{display:none;padding:24px;flex-direction:column;gap:20px}
.page.active{display:flex}
.page-header{display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:12px}
.page-title{font-size:21px;font-weight:800;color:var(--text);letter-spacing:-0.5px}
.page-sub{font-size:12px;color:var(--text2);margin-top:3px}
.btn{
  display:inline-flex;align-items:center;gap:7px;
  padding:8px 18px;border-radius:var(--radius-sm);
  font-size:13px;font-weight:600;cursor:pointer;
  border:none;font-family:inherit;transition:var(--transition);
}
.btn-primary{background:linear-gradient(135deg,var(--primary),var(--purple));color:#fff;box-shadow:0 4px 15px var(--primary-glow)}
.btn-primary:hover{transform:translateY(-1px);box-shadow:0 6px 25px var(--primary-glow)}
.btn-outline{background:none;border:1.5px solid var(--primary);color:var(--primary)}
.btn-outline:hover{background:var(--primary-glow)}
.btn svg{width:15px;height:15px}

/* ──────────────── KPI CARDS ──────────────── */
.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.kpi-card{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:var(--radius);padding:20px;
  display:flex;align-items:flex-start;gap:14px;
  transition:var(--transition);position:relative;overflow:hidden;
}
.kpi-card::after{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:var(--radius) var(--radius) 0 0;
}
.kpi-card.blue::after{background:linear-gradient(90deg,#4f46e5,#818cf8)}
.kpi-card.green::after{background:linear-gradient(90deg,#10b981,#34d399)}
.kpi-card.amber::after{background:linear-gradient(90deg,#f59e0b,#fbbf24)}
.kpi-card.purple::after{background:linear-gradient(90deg,#a855f7,#c084fc)}
.kpi-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg)}
.kpi-icon{
  width:46px;height:46px;border-radius:12px;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.kpi-icon.blue{background:rgba(79,70,229,0.1);color:var(--primary)}
.kpi-icon.green{background:rgba(16,185,129,0.1);color:var(--green)}
.kpi-icon.amber{background:rgba(245,158,11,0.1);color:var(--amber)}
.kpi-icon.purple{background:rgba(168,85,247,0.1);color:var(--purple)}
.kpi-icon svg{width:22px;height:22px;stroke:currentColor;stroke-width:2}
.kpi-info{display:flex;flex-direction:column;gap:2px;flex:1}
.kpi-label{font-size:10px;font-weight:700;color:var(--text3);text-transform:uppercase;letter-spacing:.7px}
.kpi-value{font-size:28px;font-weight:800;color:var(--text);line-height:1.2;letter-spacing:-1.2px;margin-top:3px}
.kpi-change{font-size:11px;color:var(--text2);margin-top:2px}
.kpi-change.up{color:var(--green)} .kpi-change.down{color:var(--red)}

/* ──────────────── CARD ──────────────── */
.card{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:var(--radius);padding:20px;
}
.card-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;gap:12px}
.card-title{font-size:12px;font-weight:700;color:var(--text);text-transform:uppercase;letter-spacing:.5px}
.card-badge{
  font-size:10px;font-weight:700;padding:3px 10px;border-radius:20px;
  background:var(--primary-glow);color:var(--primary);
}
.card-badge.green{background:rgba(16,185,129,0.1);color:var(--green)}
.card-badge.amber{background:rgba(245,158,11,0.1);color:var(--amber)}
.card-badge.red{background:rgba(239,68,68,0.1);color:var(--red)}
.card-sub{font-size:11px;color:var(--text3);margin-top:2px}

/* ──────────────── CHARTS ──────────────── */
.chart-wrap{position:relative;height:300px}
.chart-wrap.tall{height:360px}
.charts-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:16px}
.legend-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:12px}
.leg-item{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text2)}
.leg-dot{width:10px;height:10px;border-radius:3px;flex-shrink:0}
.tab-row{display:flex;gap:4px;background:var(--bg3);padding:3px;border-radius:var(--radius-sm)}
.tab-btn{
  background:none;border:none;font-size:11px;font-weight:600;padding:4px 12px;
  border-radius:6px;cursor:pointer;color:var(--text2);font-family:inherit;transition:var(--transition);
}
.tab-btn.active{background:var(--primary);color:#fff}

/* ──────────────── TABLE ──────────────── */
.table-wrap{overflow-x:auto;border-radius:var(--radius-sm)}
.data-table{width:100%;border-collapse:collapse;font-size:13px}
.data-table th{
  background:var(--bg3);color:var(--text3);
  font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;
  padding:10px 14px;text-align:left;white-space:nowrap;
}
.data-table td{padding:11px 14px;border-bottom:1px solid var(--border);color:var(--text2);vertical-align:middle}
.data-table tr:last-child td{border-bottom:none}
.data-table tr:hover td{background:var(--hover-bg);color:var(--text)}
.rank-cell{font-weight:800;font-size:15px;text-align:center}
.skill-name-cell{font-weight:700;color:var(--text)}
.pct-bar-wrap{display:flex;align-items:center;gap:8px}
.pct-bar{height:6px;border-radius:3px;min-width:4px;flex-shrink:0;transition:width 0.5s ease}
.pct-val{font-weight:700;color:var(--text);font-size:12px;white-space:nowrap}
.chip{
  display:inline-flex;align-items:center;
  font-size:10px;font-weight:600;padding:2px 8px;border-radius:12px;
  white-space:nowrap;
}
.chip.blue{background:rgba(79,70,229,0.1);color:var(--primary)}
.chip.green{background:rgba(16,185,129,0.1);color:var(--green)}
.chip.amber{background:rgba(245,158,11,0.1);color:var(--amber)}
.chip.red{background:rgba(239,68,68,0.1);color:var(--red)}
.chip.purple{background:rgba(168,85,247,0.1);color:var(--purple)}
.chip.cyan{background:rgba(6,182,212,0.1);color:var(--cyan)}
.trend-up{color:var(--green);font-weight:700;font-size:11px}
.trend-dn{color:var(--red);font-weight:700;font-size:11px}
.search-box{
  display:flex;align-items:center;gap:8px;background:var(--bg3);
  border:1px solid var(--border2);border-radius:var(--radius-sm);
  padding:6px 12px;
}
.search-box input{background:none;border:none;outline:none;font-family:inherit;font-size:13px;color:var(--text);flex:1}
.search-box input::placeholder{color:var(--text3)}
.search-box svg{width:16px;height:16px;stroke:var(--text3);stroke-width:2;flex-shrink:0}

/* ──────────────── INDUSTRY TABS ──────────────── */
.ind-tab-row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px}
.ind-tab{
  display:flex;align-items:center;gap:7px;
  padding:8px 16px;border-radius:30px;
  font-size:12px;font-weight:600;cursor:pointer;
  border:1.5px solid var(--border2);color:var(--text2);
  background:var(--bg2);transition:var(--transition);
}
.ind-tab:hover{border-color:var(--primary);color:var(--primary);background:var(--primary-glow)}
.ind-tab.active{border-color:var(--primary);color:#fff;background:var(--primary)}
.ind-tab .ind-emoji{font-size:15px}

/* ──────────────── RECOMMENDATION ──────────────── */
.rec-layout{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.rec-form{display:flex;flex-direction:column;gap:14px}
.form-group{display:flex;flex-direction:column;gap:6px}
.form-label{font-size:12px;font-weight:600;color:var(--text2)}
.form-input{
  background:var(--bg3);border:1.5px solid var(--border2);
  color:var(--text);font-family:inherit;font-size:13px;
  padding:9px 14px;border-radius:var(--radius-sm);
  transition:var(--transition);outline:none;width:100%;
}
.form-input:focus{border-color:var(--primary)}
.skill-tags{display:flex;flex-wrap:wrap;gap:6px;min-height:40px;padding:8px;background:var(--bg3);border:1.5px solid var(--border2);border-radius:var(--radius-sm)}
.skill-tag{
  display:flex;align-items:center;gap:4px;
  padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;
  background:var(--primary-glow);color:var(--primary);cursor:pointer;
}
.skill-tag:hover{background:rgba(239,68,68,0.1);color:var(--red)}
.rec-results{display:flex;flex-direction:column;gap:12px}
.rec-card{
  background:var(--bg3);border:1.5px solid var(--border);
  border-radius:var(--radius);padding:16px;
  display:flex;flex-direction:column;gap:8px;
  transition:var(--transition);cursor:pointer;
}
.rec-card:hover{border-color:var(--primary);box-shadow:0 4px 20px var(--primary-glow)}
.rec-card-top{display:flex;align-items:center;justify-content:space-between}
.rec-job{font-size:14px;font-weight:700;color:var(--text)}
.rec-match{font-size:12px;font-weight:700;color:var(--green)}
.rec-missing{display:flex;flex-wrap:wrap;gap:4px}
.progress-bar{height:6px;background:var(--bg3);border-radius:3px;overflow:hidden;margin-top:2px}
.progress-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--primary),var(--purple))}
.rec-missing-label{font-size:11px;color:var(--text3);font-weight:500}

/* ──────────────── ADMIN ──────────────── */
.admin-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:20px}
.admin-stat{
  background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);
  padding:20px;text-align:center;
}
.admin-stat-val{font-size:32px;font-weight:800;color:var(--primary)}
.admin-stat-label{font-size:12px;color:var(--text2);margin-top:4px}
.status-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:5px}
.status-dot.active{background:var(--green)}
.status-dot.pending{background:var(--amber)}
.status-dot.inactive{background:var(--text3)}
.action-btn{
  background:none;border:1px solid var(--border2);
  padding:5px 12px;border-radius:6px;font-size:11px;font-weight:600;
  cursor:pointer;color:var(--text2);font-family:inherit;
  transition:var(--transition);
}
.action-btn:hover{border-color:var(--primary);color:var(--primary)}
.action-btn.danger:hover{border-color:var(--red);color:var(--red)}

/* ──────────────── COURSE PORTAL ──────────────── */
.course-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.course-card{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:var(--radius);padding:18px;
  display:flex;flex-direction:column;gap:10px;
  transition:var(--transition);
}
.course-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-lg);border-color:var(--primary-light)}
.course-skill-tag{display:inline-block;padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;margin-bottom:2px}
.course-title{font-size:14px;font-weight:700;color:var(--text)}
.course-provider{font-size:11px;color:var(--text2);display:flex;align-items:center;gap:4px}
.course-meta{display:flex;align-items:center;gap:10px;font-size:11px;color:var(--text3)}
.course-cta{
  margin-top:auto;background:linear-gradient(135deg,var(--primary),var(--purple));
  color:#fff;border:none;border-radius:var(--radius-sm);padding:8px;
  font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;
  transition:var(--transition);
}
.course-cta:hover{opacity:0.9}

/* ──────────────── EMPLOYER PORTAL ──────────────── */
.job-post-card{
  background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius);
  padding:18px;display:flex;flex-direction:column;gap:8px;transition:var(--transition);
}
.job-post-card:hover{border-color:var(--primary-light);box-shadow:var(--shadow)}
.job-post-title{font-size:14px;font-weight:700;color:var(--text)}
.job-post-meta{display:flex;flex-wrap:wrap;gap:8px;font-size:11px;color:var(--text2)}

/* ──────────────── MODAL OVERLAY ──────────────── */
.modal-overlay{
  display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);
  z-index:1000;align-items:center;justify-content:center;
}
.modal-overlay.open{display:flex}
.modal{
  background:var(--bg2);border-radius:var(--radius);padding:28px;
  width:min(520px,95vw);max-height:90vh;overflow-y:auto;
  box-shadow:var(--shadow-lg);position:relative;
}
.modal-close{
  position:absolute;top:14px;right:14px;background:none;border:none;
  cursor:pointer;color:var(--text3);transition:var(--transition);padding:4px;
}
.modal-close:hover{color:var(--red)}
.modal-close svg{width:20px;height:20px;stroke:currentColor;stroke-width:2}
.modal-title{font-size:17px;font-weight:800;color:var(--text);margin-bottom:18px}

/* ──────────────── SKILL HIERARCHY ──────────────── */
.skill-tree{display:flex;flex-direction:column;gap:10px}
.skill-group{background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius-sm);overflow:hidden}
.skill-group-header{
  display:flex;align-items:center;gap:10px;padding:12px 16px;cursor:pointer;
  font-weight:700;color:var(--text);font-size:13px;
}
.skill-group-header:hover{background:var(--hover-bg)}
.skill-group-header svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;transition:transform 0.2s;color:var(--text3)}
.skill-group.open .skill-group-header svg{transform:rotate(90deg)}
.skill-group-body{display:none;padding:8px 16px 12px 32px;display:flex;flex-wrap:wrap;gap:6px}
.skill-sub{padding:4px 12px;border-radius:20px;font-size:11px;font-weight:600;border:1px solid var(--border2);color:var(--text2)}
.skill-sub.high{border-color:var(--green);color:var(--green);background:rgba(16,185,129,0.05)}
.skill-sub.mid{border-color:var(--amber);color:var(--amber);background:rgba(245,158,11,0.05)}
.skill-sub.low{border-color:var(--text3);color:var(--text3)}

/* ──────────────── EMPTY STATE ──────────────── */
.empty-state{text-align:center;padding:40px;color:var(--text3)}
.empty-state svg{width:48px;height:48px;stroke:var(--text3);stroke-width:1.5;margin:0 auto 12px;display:block}

/* ──────────────── DIAGNOSIS CARD ──────────────── */
.diag-card{
  background:var(--bg2);border:1.5px solid var(--border);
  border-radius:var(--radius);overflow:hidden;
  transition:var(--transition);margin-bottom:16px;
}
.diag-card:hover{box-shadow:var(--shadow-lg)}
.diag-header{
  display:flex;align-items:center;justify-content:space-between;
  padding:16px 20px;border-bottom:1px solid var(--border);
}
.diag-job-name{font-size:15px;font-weight:800;color:var(--text);display:flex;align-items:center;gap:8px}
.diag-match-badge{
  font-size:13px;font-weight:800;padding:4px 14px;
  border-radius:20px;white-space:nowrap;
}
.diag-match-badge.high{background:rgba(16,185,129,0.12);color:var(--green)}
.diag-match-badge.mid{background:rgba(245,158,11,0.12);color:var(--amber)}
.diag-match-badge.low{background:rgba(239,68,68,0.12);color:var(--red)}
.diag-progress-wrap{padding:0 20px;margin:12px 0 4px}
.diag-progress-track{height:8px;background:var(--bg3);border-radius:4px;overflow:hidden}
.diag-progress-fill{height:100%;border-radius:4px;transition:width 0.8s ease}
.diag-section{
  padding:14px 20px;
}
.diag-section-title{
  font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;
  margin-bottom:10px;display:flex;align-items:center;gap:6px;
}
.diag-section-title.diagnosis{color:var(--red)}
.diag-section-title.prescription{color:var(--primary)}
.diag-skill-grid{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:4px}
.diag-skill-item{
  display:inline-flex;align-items:center;gap:5px;
  padding:4px 12px;border-radius:20px;
  font-size:11px;font-weight:600;
}
.diag-skill-item.have{
  background:rgba(16,185,129,0.1);color:var(--green);
  border:1px solid rgba(16,185,129,0.25);
}
.diag-skill-item.missing{
  background:rgba(239,68,68,0.08);color:var(--red);
  border:1px dashed rgba(239,68,68,0.4);
}
.prescription-zone{
  background:linear-gradient(135deg,rgba(79,70,229,0.04),rgba(168,85,247,0.04));
  border-top:1px solid var(--border);border-radius:0 0 var(--radius) var(--radius);
  padding:14px 20px;
}
.mini-course-card{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  background:var(--bg2);border:1px solid var(--border);
  border-radius:var(--radius-sm);padding:10px 14px;
  margin-bottom:8px;transition:var(--transition);
}
.mini-course-card:hover{border-color:var(--primary-light);box-shadow:0 2px 12px var(--primary-glow)}
.mini-course-card:last-child{margin-bottom:0}
.mini-course-left{display:flex;flex-direction:column;gap:3px;flex:1;min-width:0}
.mini-course-skill-tag{
  font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;
  color:var(--primary);margin-bottom:1px;
}
.mini-course-title{font-size:12px;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mini-course-meta{display:flex;align-items:center;gap:8px;font-size:10px;color:var(--text3);margin-top:2px}
.mini-course-enroll{
  flex-shrink:0;
  background:linear-gradient(135deg,var(--primary),var(--purple));
  color:#fff;border:none;border-radius:var(--radius-sm);
  padding:6px 14px;font-size:11px;font-weight:700;
  cursor:pointer;font-family:inherit;transition:var(--transition);
  white-space:nowrap;
}
.mini-course-enroll:hover{transform:translateY(-1px);box-shadow:0 4px 15px var(--primary-glow)}
.no-gap-msg{
  display:flex;align-items:center;gap:8px;
  padding:12px 16px;border-radius:var(--radius-sm);
  background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.2);
  font-size:12px;font-weight:600;color:var(--green);
}

/* ──────────────── RESPONSIVE ──────────────── */
@media(max-width:900px){
  .kpi-grid{grid-template-columns:repeat(2,1fr)}
  .charts-grid{grid-template-columns:1fr}
  .rec-layout{grid-template-columns:1fr}
  .course-grid{grid-template-columns:1fr 1fr}
  .admin-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:600px){
  .kpi-grid{grid-template-columns:1fr}
  .course-grid{grid-template-columns:1fr}
  .admin-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div class="shell">

<!-- ══════════ SIDEBAR ══════════ -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <div class="logo-icon">
      <svg viewBox="0 0 24 24" fill="none"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div>
      <div class="logo-title">SkillGap<span style="color:var(--primary)">AI</span></div>
      <div class="logo-sub">Phân Tích Kỹ Năng Lao Động</div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-group-label">Phân Tích</div>
    <div class="nav-item active" id="nav-dashboard" onclick="switchPage('dashboard',this)">
      <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      Tổng Quan
      <span class="nav-badge green">Live</span>
    </div>
    <div class="nav-item" id="nav-softskills" onclick="switchPage('softskills',this)">
      <svg viewBox="0 0 24 24" fill="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      Kỹ Năng Mềm Chung
      <span class="nav-badge">Top10</span>
    </div>
    <div class="nav-item" id="nav-industry" onclick="switchPage('industry',this)">
      <svg viewBox="0 0 24 24" fill="none"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
      Kỹ Năng Theo Ngành
    </div>
    <div class="nav-item" id="nav-recommend" onclick="switchPage('recommend',this)">
      <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      Gợi Ý Nghề Nghiệp
      <span class="nav-badge" style="background:rgba(168,85,247,0.1);color:var(--purple)">AI</span>
    </div>

    <div class="nav-group-label" style="margin-top:12px">Quản Lý</div>
    <div class="nav-item" id="nav-workers" onclick="switchPage('workers',this)">
      <svg viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
      Người Lao Động
      <span class="nav-badge">500</span>
    </div>
    <div class="nav-item" id="nav-employers" onclick="switchPage('employers',this)">
      <svg viewBox="0 0 24 24" fill="none"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
      Nhà Tuyển Dụng
      <span class="nav-badge">1,000</span>
    </div>
    <div class="nav-item" id="nav-courses" onclick="switchPage('courses',this)">
      <svg viewBox="0 0 24 24" fill="none"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
      Khóa Học
      <span class="nav-badge green">Mới</span>
    </div>
    <div class="nav-item" id="nav-admin" onclick="switchPage('admin',this)">
      <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
      Quản Trị Hệ Thống
    </div>
  </nav>
  <div class="sidebar-footer">
    <div class="ai-dot"></div>
    <div class="footer-text">AI Engine đang chạy · v2.0.0</div>
  </div>
</aside>

<!-- ══════════ MAIN ══════════ -->
<div class="main" id="main">
  <header class="topbar">
    <div class="topbar-left">
      <button class="menu-btn" onclick="toggleSidebar()">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="breadcrumb">
        <span style="color:var(--text3)">SkillGapAI</span>
        <span class="bc-sep">›</span>
        <span class="bc-cur" id="breadcrumbText">Tổng Quan</span>
      </div>
    </div>
    <div class="topbar-right">
      <div class="topbar-filters" id="topbarFilters">
        <span class="filter-label">Ngành</span>
        <select class="filter-select" id="globalIndustry" onchange="applyGlobalFilter()">
          <option value="all">Tất cả</option>
          <option value="IT">IT &amp; Công nghệ</option>
          <option value="tourism">Du lịch &amp; Khách sạn</option>
          <option value="logistics">Logistics &amp; XNK</option>
          <option value="economics">Kinh tế &amp; Tài chính</option>
          <option value="agriculture">Nông nghiệp</option>
        </select>
        <span class="filter-label" style="margin-left:6px">Kỳ</span>
        <select class="filter-select">
          <option>Quý 3/2026</option><option>Quý 2/2026</option><option>Quý 1/2026</option>
        </select>
      </div>
      <button class="theme-toggle" onclick="toggleTheme()" title="Đổi giao diện">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
      </button>
      <button class="icon-btn" style="position:relative">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
        <span class="notif-dot"></span>
      </button>
      <div class="user-chip">
        <div class="user-avatar">AD</div>
        <span class="user-name">Admin</span>
      </div>
    </div>
  </header>

  <!-- ══ PAGE: TỔNG QUAN ══ -->
  <div class="page active" id="page-dashboard">
    <div class="page-header">
      <div>
        <h1 class="page-title">Dashboard Tổng Quan</h1>
        <p class="page-sub">Dữ liệu từ 1,000 Job Postings (TopCV) · 500 CV Sinh viên · AI xử lý tự động</p>
      </div>
      <button class="btn btn-primary" onclick="alert('Đang xuất báo cáo PDF...')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Xuất Báo Cáo
      </button>
    </div>

    <!-- KPI -->
    <div class="kpi-grid">
      <div class="kpi-card blue">
        <div class="kpi-icon blue"><svg viewBox="0 0 24 24" fill="none"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg></div>
        <div class="kpi-info">
          <div class="kpi-label">Tin Tuyển Dụng</div>
          <div class="kpi-value">1,000</div>
          <div class="kpi-change up">↗ Từ TopCV – 4 ngành chủ chốt</div>
        </div>
      </div>
      <div class="kpi-card green">
        <div class="kpi-icon green"><svg viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div>
        <div class="kpi-info">
          <div class="kpi-label">CV Sinh Viên</div>
          <div class="kpi-value">500</div>
          <div class="kpi-change up">↗ Đã phân loại kỹ năng bằng AI</div>
        </div>
      </div>
      <div class="kpi-card amber">
        <div class="kpi-icon amber"><svg viewBox="0 0 24 24" fill="none"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
        <div class="kpi-info">
          <div class="kpi-label">Gap Trung Bình</div>
          <div class="kpi-value" style="color:var(--amber)">34.6%</div>
          <div class="kpi-change down">↗ Cần cải thiện khẩn cấp</div>
        </div>
      </div>
      <div class="kpi-card purple">
        <div class="kpi-icon purple"><svg viewBox="0 0 24 24" fill="none"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
        <div class="kpi-info">
          <div class="kpi-label">Kỹ Năng AI Phân Loại</div>
          <div class="kpi-value" style="color:var(--purple)">68</div>
          <div class="kpi-change up">↗ Nhóm lớn → nhóm nhỏ</div>
        </div>
      </div>
    </div>

    <!-- Charts overview -->
    <div class="charts-grid">
      <div class="card">
        <div class="card-header">
          <div>
            <div class="card-title">Top 5 Kỹ Năng Thiếu Hụt Nhiều Nhất</div>
            <div class="card-sub">Gap = Demand – Supply (dữ liệu Q3/2026)</div>
          </div>
          <div class="tab-row">
            <button class="tab-btn active" onclick="setOverviewChartType('bar',this)">Cột</button>
            <button class="tab-btn" onclick="setOverviewChartType('horizontal',this)">Ngang</button>
          </div>
        </div>
        <div class="chart-wrap"><canvas id="overviewGapChart"></canvas></div>
        <div class="legend-row">
          <div class="leg-item"><div class="leg-dot" style="background:#6366f1"></div>Nhu cầu (Demand)</div>
          <div class="leg-item"><div class="leg-dot" style="background:#f59e0b"></div>Cung lao động (Supply)</div>
          <div class="leg-item"><div class="leg-dot" style="background:#ef4444"></div>Thiếu hụt (Gap)</div>
        </div>
      </div>
      <div class="card">
        <div class="card-header">
          <div>
            <div class="card-title">Phân Bổ Ngành Nghề</div>
            <div class="card-sub">Tỷ lệ tin tuyển dụng theo ngành</div>
          </div>
        </div>
        <div class="chart-wrap"><canvas id="industryPieChart"></canvas></div>
      </div>
    </div>
  </div>

  <!-- ══ PAGE: KỸ NĂNG MỀM ══ -->
  <div class="page" id="page-softskills">
    <div class="page-header">
      <div>
        <h1 class="page-title">Top 10 Kỹ Năng Mềm Chung</h1>
        <p class="page-sub">Điểm chung của tất cả ngành nghề · Xếp hạng theo Nhu cầu thị trường</p>
      </div>
    </div>

    <!-- 3 bảng xếp hạng -->
    <div class="charts-grid" style="grid-template-columns:1fr 1fr 1fr">
      <div class="card">
        <div class="card-header">
          <div class="card-title">🏆 Top Nhu Cầu Thị Trường</div>
          <span class="card-badge">Demand %</span>
        </div>
        <div class="chart-wrap" style="height:240px"><canvas id="softDemandChart"></canvas></div>
      </div>
      <div class="card">
        <div class="card-header">
          <div class="card-title">👥 Lao Động Đang Có</div>
          <span class="card-badge green">Supply %</span>
        </div>
        <div class="chart-wrap" style="height:240px"><canvas id="softSupplyChart"></canvas></div>
      </div>
      <div class="card">
        <div class="card-header">
          <div class="card-title">⚡ Kỹ Năng Thiếu Hụt</div>
          <span class="card-badge red">Gap %</span>
        </div>
        <div class="chart-wrap" style="height:240px"><canvas id="softGapChart"></canvas></div>
      </div>
    </div>

    <!-- Bảng chi tiết -->
    <div class="card">
      <div class="card-header">
        <div>
          <div class="card-title">Bảng Xếp Hạng Chi Tiết – Kỹ Năng Mềm</div>
          <div class="card-sub">Sắp xếp theo Demand giảm dần</div>
        </div>
        <div class="search-box">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="text" placeholder="Tìm kỹ năng..." oninput="filterSoftTable(this.value)"/>
        </div>
      </div>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width:50px">#</th>
              <th>Kỹ Năng Mềm</th>
              <th>Nhu Cầu (Demand)</th>
              <th>Cung Hiện Có (Supply)</th>
              <th>Thiếu Hụt (Gap)</th>
              <th>Xu Hướng</th>
              <th>Hành Động</th>
            </tr>
          </thead>
          <tbody id="softSkillTableBody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ══ PAGE: KỸ NĂNG THEO NGÀNH ══ -->
  <div class="page" id="page-industry">
    <div class="page-header">
      <div>
        <h1 class="page-title">Kỹ Năng Theo Ngành Nghề</h1>
        <p class="page-sub">Chọn ngành để xem Top 10 kỹ năng quan trọng nhất</p>
      </div>
    </div>

    <!-- Industry tabs -->
    <div class="ind-tab-row" id="industryTabs">
      <div class="ind-tab active" onclick="selectIndustry('IT',this)"><span class="ind-emoji">💻</span> IT &amp; Công nghệ</div>
      <div class="ind-tab" onclick="selectIndustry('tourism',this)"><span class="ind-emoji">✈️</span> Du lịch &amp; Khách sạn</div>
      <div class="ind-tab" onclick="selectIndustry('logistics',this)"><span class="ind-emoji">📦</span> Logistics &amp; XNK</div>
      <div class="ind-tab" onclick="selectIndustry('economics',this)"><span class="ind-emoji">📊</span> Kinh tế &amp; Tài chính</div>
      <div class="ind-tab" onclick="selectIndustry('agriculture',this)"><span class="ind-emoji">🌾</span> Nông nghiệp</div>
    </div>

    <!-- Industry summary -->
    <div class="kpi-grid" id="industryKPIs" style="grid-template-columns:repeat(3,1fr)">
      <!-- Filled by JS -->
    </div>

    <!-- 3 charts -->
    <div class="charts-grid" style="grid-template-columns:1fr 1fr 1fr">
      <div class="card">
        <div class="card-header"><div class="card-title">🏆 Nhu Cầu Tuyển Dụng</div><span class="card-badge">Demand</span></div>
        <div class="chart-wrap" style="height:240px"><canvas id="indDemandChart"></canvas></div>
      </div>
      <div class="card">
        <div class="card-header"><div class="card-title">👥 Cung Lao Động</div><span class="card-badge green">Supply</span></div>
