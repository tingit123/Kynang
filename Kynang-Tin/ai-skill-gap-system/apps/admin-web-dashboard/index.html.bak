function runRecommendation() {
  const major   = document.getElementById('recMajor').value;
  const name    = document.getElementById('recName').value || 'Bạn';
  const level   = document.getElementById('recLevel');
  const levelTxt= level.options[level.selectedIndex].text;
  if(!major){ alert('Vui lòng chọn chuyên ngành!'); return; }
  if(selectedSkills.length===0){ alert('Vui lòng chọn ít nhất 1 kỹ năng bạn đang có!'); return; }

  const jobs = JOB_REQUIREMENTS[major] || [];
  const userSkillsLow = selectedSkills.map(s=>s.toLowerCase());

  // ── Ẩn empty state, hiện header
  document.getElementById('recEmptyState').style.display   = 'none';
  document.getElementById('recResultHeader').style.display = 'block';
  document.getElementById('recResultName').textContent = `Kết quả phân tích cho: ${name}`;
  document.getElementById('recResultSub').textContent  = `${major === 'IT'?'Công nghệ thông tin':major} · ${levelTxt} · ${selectedSkills.length} kỹ năng đã khai báo`;

  const container = document.getElementById('recJobCards');
  container.innerHTML = '';

  const sorted = jobs.map(j => {
    const userHas  = j.reqSkills.filter(sk => userSkillsLow.some(u => u===sk.name.toLowerCase()||sk.name.toLowerCase().includes(u)||u.includes(sk.name.toLowerCase())));
    const missing  = j.reqSkills.filter(sk => !userSkillsLow.some(u => u===sk.name.toLowerCase()||sk.name.toLowerCase().includes(u)||u.includes(sk.name.toLowerCase())));
    const pct      = Math.round((userHas.length / j.reqSkills.length) * 100);
    return {...j, userHas, missing, pct};
  }).sort((a,b)=>b.pct-a.pct);

  sorted.forEach(j => {
    const pctColor  = j.pct>=70?'var(--green)':j.pct>=40?'var(--amber)':'var(--red)';
    const badgeCls  = j.pct>=70?'high':j.pct>=40?'mid':'low';
    const fillGrad  = j.pct>=70?'linear-gradient(90deg,#10b981,#34d399)':j.pct>=40?'linear-gradient(90deg,#f59e0b,#fbbf24)':'linear-gradient(90deg,#ef4444,#f87171)';

    // ── PHẦN 1: Chẩn đoán
    const hasHTML = j.userHas.map(sk=>
      `<span class="diag-skill-item have">✅ ${sk.name}<span style="font-size:9px;opacity:.7;margin-left:3px">${sk.importance}</span></span>`
    ).join('');
    const missingHTML = j.missing.map(sk=>
      `<span class="diag-skill-item missing">❌ ${sk.name}<span style="font-size:9px;opacity:.7;margin-left:3px">${sk.importance}</span></span>`
    ).join('');

    // ── PHẦN 2: Kê đơn khóa học
    let prescHTML = '';
    if(j.missing.length === 0){
      prescHTML = `<div class="no-gap-msg">🎉 Tuyệt vời! Bạn đã đáp ứng <strong>đầy đủ</strong> yêu cầu của vị trí này. Hãy cập nhật CV và ứng tuyển ngay!</div>`;
    } else {
      const courseCards = j.missing.map(sk => {
        const courses = SKILL_COURSES_MAP[sk.name] || [{title:`Học ${sk.name}`, src:'Coursera', dur:'Đang cập nhật', price:'Miễn phí', rating:4.5, url:'#'}];
        return courses.map(c => `
          <div class="mini-course-card">
            <div class="mini-course-left">
              <div class="mini-course-skill-tag">Bù đắp: ${sk.name}</div>
              <div class="mini-course-title" title="${c.title}">${c.title}</div>
              <div class="mini-course-meta">
                <span>🎓 ${c.src}</span>
                <span>⏱ ${c.dur}</span>
                <span>💰 ${c.price}</span>
                <span>⭐ ${c.rating}</span>
              </div>
            </div>
            <button class="mini-course-enroll" onclick="window.open('${c.url}','_blank')">Đăng Ký Học →</button>
          </div>
        `).join('');
      }).join('');
      prescHTML = courseCards;
    }

    const card = document.createElement('div');
    card.className = 'diag-card';
    card.innerHTML = `
      <div class="diag-header">
        <div class="diag-job-name">${j.icon} ${j.job}</div>
        <span class="diag-match-badge ${badgeCls}">${j.pct}% Phù Hợp</span>
      </div>
      <div class="diag-progress-wrap">
        <div class="diag-progress-track">
          <div class="diag-progress-fill" style="width:${j.pct}%;background:${fillGrad}"></div>
        </div>
      </div>
      <div class="diag-section">
        <div class="diag-section-title diagnosis">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          CHẨN ĐOÁN KỸ NĂNG — ${j.reqSkills.length} kỹ năng yêu cầu
        </div>
        ${j.userHas.length>0?`<div style="margin-bottom:8px">${hasHTML}</div>`:''}
        ${j.missing.length>0?missingHTML:`<div style="font-size:11px;color:var(--green);font-weight:600">✅ Bạn đã có đủ tất cả kỹ năng!</div>`}
      </div>
      <div class="prescription-zone">
        <div class="diag-section-title prescription" style="margin-bottom:12px">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          KÊ ĐƠN KHÓA HỌC — LỘ TRÌNH BÙ ĐẮP GAP
        </div>
        ${prescHTML}
      </div>
    `;
    container.appendChild(card);
  });
}

// ══════════════════════════════════════════════════════
//  WORKERS TABLE
// ══════════════════════════════════════════════════════
function renderWorkers() {
  const tbody = document.getElementById('workersTableBody');
  if(!tbody) return;
  tbody.innerHTML = WORKERS_DATA.map(w=>{
    const chips = w.skills.map(s=>`<span class="chip blue">${s}</span>`).join(' ');
    const statusMap = {active:'active',pending:'pending',inactive:'inactive'};
    const statusLabel = {active:'✅ Đã phân tích',pending:'⏳ Chờ xử lý',inactive:'❌ Không hoạt động'};
    return `<tr>
      <td>${w.id}</td>
      <td class="skill-name-cell">${w.name}</td>
      <td>${w.major}</td>
      <td style="color:var(--text2)">${w.school}</td>
      <td style="display:flex;flex-wrap:wrap;gap:4px;padding-top:11px">${chips}</td>
      <td><span class="chip green">${w.match}</span></td>
      <td><span class="status-dot ${statusMap[w.status]}"></span>${statusLabel[w.status]}</td>
      <td><button class="action-btn">Chi tiết</button></td>
    </tr>`;
  }).join('');
}

// ══════════════════════════════════════════════════════
//  EMPLOYERS
// ══════════════════════════════════════════════════════
function renderEmployers() {
  const grid = document.getElementById('jobPostsGrid');
  if(!grid) return;
  grid.innerHTML = JOBS_DATA.map(j=>`
    <div class="job-post-card">
      <div class="job-post-title">${j.title}</div>
      <div class="job-post-meta">
        <span>🏢 ${j.company}</span>
        <span>📁 ${j.industry}</span>
        <span>💰 ${j.salary}</span>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:6px">
        ${j.skills.map(s=>`<span class="chip blue">${s}</span>`).join('')}
      </div>
      <div style="display:flex;gap:6px;margin-top:10px">
        <button class="action-btn">Xem chi tiết</button>
        <button class="action-btn danger">Xóa</button>
      </div>
    </div>
  `).join('');
}

// ══════════════════════════════════════════════════════
//  COURSES
// ══════════════════════════════════════════════════════
function renderCourses() {
  const grid = document.getElementById('courseGrid');
  if(!grid) return;
  grid.innerHTML = COURSES_DATA.map(c=>`
    <div class="course-card">
      <span class="course-skill-tag" style="background:${c.color}18;color:${c.color}">${c.skill}</span>
      <div class="course-title">${c.title}</div>
      <div class="course-provider">🎓 ${c.provider}</div>
      <div class="course-meta">
        <span>⏱ ${c.duration}</span>
        <span>💰 ${c.price}</span>
        <span>⭐ ${c.rating}</span>
      </div>
      <button class="course-cta" onclick="alert('Đang mở khóa học ${c.title}...')">Đăng Ký Học</button>
    </div>
  `).join('');
}

// ══════════════════════════════════════════════════════
//  ADMIN
// ══════════════════════════════════════════════════════
function renderAdmin() {
  const tbody = document.getElementById('adminUsersBody');
  if(!tbody) return;
  const roleMap = {admin:'Admin',employer:'Nhà Tuyển Dụng',course_provider:'Nhà Cung Cấp KH',worker:'Người Lao Động'};
  const roleColor = {admin:'purple',employer:'blue',course_provider:'cyan',worker:'green'};
  tbody.innerHTML = ADMIN_USERS.map(u=>`<tr>
    <td>${u.id}</td>
    <td class="skill-name-cell">${u.name}</td>
    <td><span class="chip ${roleColor[u.role]}">${roleMap[u.role]}</span></td>
    <td style="color:var(--text2)">${u.joined}</td>
    <td><span class="status-dot ${u.status}"></span>${u.status==='active'?'Hoạt động':u.status==='pending'?'Chờ duyệt':'Không hoạt động'}</td>
    <td style="display:flex;gap:4px">
      <button class="action-btn">Sửa</button>
      <button class="action-btn danger">Xóa</button>
    </td>
  </tr>`).join('');
}

// ══════════════════════════════════════════════════════
//  MODALS
// ══════════════════════════════════════════════════════
function openJobModal(){ document.getElementById('jobModal').classList.add('open'); }
function closeJobModal(){ document.getElementById('jobModal').classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('open')}));

// ══════════════════════════════════════════════════════
//  THEME & SIDEBAR
// ══════════════════════════════════════════════════════
function toggleTheme() {
  const html = document.documentElement;
  html.setAttribute('data-theme', html.getAttribute('data-theme')==='dark'?'light':'dark');
}
function toggleSidebar() {
  const sb = document.getElementById('sidebar');
  const mn = document.getElementById('main');
  sb.classList.toggle('collapsed');
  mn.classList.toggle('expanded');
}

function applyGlobalFilter(){}

