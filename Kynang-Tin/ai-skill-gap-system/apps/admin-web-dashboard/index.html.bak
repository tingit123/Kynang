//  NAVIGATION
// ══════════════════════════════════════════════════════
const PAGE_LABELS = {
  dashboard:"Tổng Quan",softskills:"Kỹ Năng Mềm Chung",
  industry:"Kỹ Năng Theo Ngành",recommend:"Gợi Ý Nghề Nghiệp",
  workers:"Người Lao Động",employers:"Nhà Tuyển Dụng",
  courses:"Khóa Học",admin:"Quản Trị"
};

function switchPage(name, el) {
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  const pg = document.getElementById('page-'+name);
  if(pg) pg.classList.add('active');
  const nav = document.getElementById('nav-'+name);
  if(nav) nav.classList.add('active');
  document.getElementById('breadcrumbText').textContent = PAGE_LABELS[name]||name;
  initPage(name);
}

function initPage(name) {
  if(name==='dashboard') initDashboardCharts();
  if(name==='softskills') initSoftSkills();
  if(name==='industry') initIndustry(currentIndustry);
  if(name==='recommend') initRecommend();
  if(name==='workers') renderWorkers();
  if(name==='employers') renderEmployers();
  if(name==='courses') renderCourses();
  if(name==='admin') renderAdmin();
}

// ══════════════════════════════════════════════════════
//  DASHBOARD CHARTS
// ══════════════════════════════════════════════════════
let overviewHoriz = false;
function initDashboardCharts() {
  buildOverviewGapChart();
  buildIndustryPie();
}

function buildOverviewGapChart() {
  const ctx = document.getElementById('overviewGapChart');
  if(!ctx) return;
  if(overviewChartInst) overviewChartInst.destroy();
  const top5 = SOFT_SKILLS.slice(0,5);
  overviewChartInst = new Chart(ctx, {
    type:'bar',
    data:{
      labels: top5.map(s=>s.skill.split('(')[0].trim()),
      datasets:[
        {label:'Nhu cầu (Demand)',data:top5.map(s=>s.demand),backgroundColor:'rgba(99,102,241,0.8)',borderRadius:5},
        {label:'Cung lao động (Supply)',data:top5.map(s=>s.supply),backgroundColor:'rgba(245,158,11,0.8)',borderRadius:5},
        {label:'Thiếu hụt (Gap)',data:top5.map(s=>s.gap),backgroundColor:'rgba(239,68,68,0.8)',borderRadius:5},
      ]
    },
    options:{
      indexAxis: overviewHoriz?'y':'x',
      responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>`${ctx.dataset.label}: ${ctx.parsed[overviewHoriz?'x':'y'].toFixed(1)}%`}}},
      scales:{
        x:{grid:{color:'var(--grid-color,rgba(0,0,0,0.04))'},ticks:{color:'#8892a4',font:{size:10}}},
        y:{grid:{color:'var(--grid-color,rgba(0,0,0,0.04))'},ticks:{color:'#8892a4',font:{size:10}}}
      }
    }
  });
}

function setOverviewChartType(type,btn){
  overviewHoriz = (type==='horizontal');
  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  buildOverviewGapChart();
}

function buildIndustryPie() {
  const ctx = document.getElementById('industryPieChart');
  if(!ctx) return;
  if(industryPieInst) industryPieInst.destroy();
  industryPieInst = new Chart(ctx,{
    type:'doughnut',
    data:{
      labels:['IT & Công nghệ','Du lịch','Logistics','Kinh tế','Nông nghiệp'],
      datasets:[{data:[385,218,241,156,0],backgroundColor:['#6366f1','#10b981','#f59e0b','#ef4444','#a855f7'],borderWidth:0,hoverOffset:8}]
    },
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:'#8892a4',font:{size:11},padding:12}}}}
  });
}

// ══════════════════════════════════════════════════════
//  SOFT SKILLS
// ══════════════════════════════════════════════════════
function initSoftSkills() {
  buildSoftCharts();
  renderSoftTable(SOFT_SKILLS);
}

function buildSoftCharts() {
  buildSmallBarChart('softDemandChart', SOFT_SKILLS, 'demand', 'rgba(99,102,241,0.85)');
  buildSmallBarChart('softSupplyChart', SOFT_SKILLS, 'supply', 'rgba(245,158,11,0.85)');
  buildSmallBarChart('softGapChart',    SOFT_SKILLS, 'gap',    'rgba(239,68,68,0.85)');
}

function buildSmallBarChart(canvasId, data, field, color) {
  const ctx = document.getElementById(canvasId);
  if(!ctx) return;
  // destroy old
  if(ctx._chart) ctx._chart.destroy();
  const sorted = [...data].sort((a,b)=>b[field]-a[field]).slice(0,10);
  ctx._chart = new Chart(ctx,{
    type:'bar',
    data:{
      labels:sorted.map(s=>s.skill.length>14?s.skill.substring(0,14)+'…':s.skill),
      datasets:[{data:sorted.map(s=>s[field]),backgroundColor:color,borderRadius:4}]
    },
    options:{
      indexAxis:'y',responsive:true,maintainAspectRatio:false,
      plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>`${ctx.parsed.x.toFixed(1)}%`}}},
      scales:{
        x:{grid:{display:false},ticks:{color:'#8892a4',font:{size:9}}},
        y:{grid:{display:false},ticks:{color:'#8892a4',font:{size:9}}}
      }
    }
  });
}

function renderSoftTable(data) {
  const tbody = document.getElementById('softSkillTableBody');
  if(!tbody) return;
  const sorted = [...data].sort((a,b)=>b.demand-a.demand);
  tbody.innerHTML = sorted.map((s,i)=>{
    const medal = i===0?'🥇':i===1?'🥈':i===2?'🥉':(i+1);
    const gapColor = s.gap>40?'red':s.gap>25?'amber':'green';
    const courseBtn = `<button class="action-btn" onclick="alert('Khóa học:\\n\\n${s.courses.join('\\n')}')">Xem ${s.courses.length} khóa học</button>`;
    return `<tr>
      <td class="rank-cell">${medal}</td>
      <td class="skill-name-cell">${s.skill}</td>
      <td><div class="pct-bar-wrap"><div class="pct-bar" style="width:${s.demand*0.8}px;max-width:120px;background:#6366f1"></div><span class="pct-val">${s.demand}%</span></div></td>
      <td><div class="pct-bar-wrap"><div class="pct-bar" style="width:${s.supply*0.8}px;max-width:120px;background:#f59e0b"></div><span class="pct-val">${s.supply}%</span></div></td>
      <td><span class="chip ${gapColor}">${s.gap.toFixed(1)}%</span></td>
      <td><span class="${s.trend.startsWith('+')?'trend-up':'trend-dn'}">🔺 ${s.trend}</span></td>
      <td>${courseBtn}</td>
    </tr>`;
  }).join('');
}

function filterSoftTable(q) {
  const filtered = SOFT_SKILLS.filter(s=>s.skill.toLowerCase().includes(q.toLowerCase()));
  renderSoftTable(filtered);
}

// ══════════════════════════════════════════════════════
//  INDUSTRY
// ══════════════════════════════════════════════════════
function selectIndustry(key, el) {
  currentIndustry = key;
  document.querySelectorAll('.ind-tab').forEach(t=>t.classList.remove('active'));
  if(el) el.classList.add('active');
  initIndustry(key);
}

function initIndustry(key) {
  const ind = INDUSTRY_DATA[key];
  if(!ind) return;
  document.getElementById('industryTableTitle').textContent = `Top 10 Kỹ Năng Quan Trọng – ${ind.label}`;

  // KPI cards
  const kpiEl = document.getElementById('industryKPIs');
  if(kpiEl) kpiEl.innerHTML = `
    <div class="kpi-card blue">
      <div class="kpi-icon blue"><svg viewBox="0 0 24 24" fill="none"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg></div>
      <div class="kpi-info"><div class="kpi-label">Tin Tuyển Dụng</div><div class="kpi-value">${ind.jobs}</div><div class="kpi-change up">Từ TopCV</div></div>
    </div>
    <div class="kpi-card amber">
      <div class="kpi-icon amber"><svg viewBox="0 0 24 24" fill="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></div>
      <div class="kpi-info"><div class="kpi-label">Mức Lương TB</div><div class="kpi-value">${ind.avgSalary}</div><div class="kpi-change">Triệu đồng/tháng</div></div>
    </div>
    <div class="kpi-card red">
      <div class="kpi-icon" style="background:rgba(239,68,68,0.1);color:var(--red)"><svg viewBox="0 0 24 24" fill="none"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
      <div class="kpi-info"><div class="kpi-label">Kỹ Năng Thiếu Nhất</div><div class="kpi-value" style="font-size:16px;letter-spacing:-0.5px;color:var(--red)">${ind.topMissing}</div><div class="kpi-change down">Gap cao nhất ngành</div></div>
    </div>`;

  // build 3 charts
  buildSmallBarChart('indDemandChart', ind.skills, 'demand', 'rgba(99,102,241,0.85)');
  buildSmallBarChart('indSupplyChart', ind.skills, 'supply', 'rgba(245,158,11,0.85)');
  buildSmallBarChart('indGapChart',    ind.skills, 'gap',    'rgba(239,68,68,0.85)');

  // table
  renderIndustryTable(ind.skills);
}

function renderIndustryTable(skills) {
  const tbody = document.getElementById('industryTableBody');
  if(!tbody) return;
  const sorted = [...skills].sort((a,b)=>b.demand-a.demand);
  tbody.innerHTML = sorted.map((s,i)=>{
    const medal = i===0?'🥇':i===1?'🥈':i===2?'🥉':(i+1);
    const gapColor = s.gap>45?'red':s.gap>25?'amber':'green';
    const groupColor = s.group.includes('AI')||s.group.includes('Lập')? 'blue' : s.group.includes('Ngoại')? 'cyan' : 'purple';
    const courseBtn = `<button class="action-btn" onclick="alert('Khóa học gợi ý:\\n\\n${s.courses.join('\\n')}')">Xem khóa học</button>`;
    return `<tr>
      <td class="rank-cell">${medal}</td>
      <td class="skill-name-cell">${s.skill}</td>
      <td><span class="chip ${groupColor}">${s.group}</span></td>
      <td><div class="pct-bar-wrap"><div class="pct-bar" style="width:${s.demand*0.8}px;max-width:100px;background:#6366f1"></div><span class="pct-val">${s.demand}%</span></div></td>
      <td><div class="pct-bar-wrap"><div class="pct-bar" style="width:${s.supply*0.8}px;max-width:100px;background:#f59e0b"></div><span class="pct-val">${s.supply}%</span></div></td>
      <td><span class="chip ${gapColor}">${s.gap.toFixed(1)}%</span></td>
      <td><span class="trend-up">🔺 ${s.trend}</span></td>
      <td>${courseBtn}</td>
    </tr>`;
  }).join('');
}

